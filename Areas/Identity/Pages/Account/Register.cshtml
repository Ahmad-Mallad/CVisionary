@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}


<div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="col-lg-5 col-md-7 col-12">
        <div class="card auth-card shadow-lg border-0">
            <div class="card-header text-center">
                <h3 class="fw-bold mb-1">Create Your CVisionary Account</h3>
                <p class="mb-0 text-white-50">Sign up to unlock AI-powered resume & portfolio tools.</p>
            </div>
            <div class="card-body px-4 py-5">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" autocomplete="off">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-4 position-relative form-floating">
                        <input asp-for="Input.FirstName" class="form-control ps-5" placeholder="First Name" />
                        <label asp-for="Input.FirstName"><i class="bi bi-person form-icon"></i> First Name</label>
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                    <div class="mb-4 position-relative form-floating">
                        <input asp-for="Input.LastName" class="form-control ps-5" placeholder="Last Name" />
                        <label asp-for="Input.LastName"><i class="bi bi-person form-icon"></i> Last Name</label>
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                    <div class="mb-4 position-relative form-floating">
                        <input asp-for="Input.PhoneNumber" class="form-control ps-5" placeholder="Phone Number" />
                        <label asp-for="Input.PhoneNumber"><i class="bi bi-telephone form-icon"></i> Phone Number</label>
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="mb-4 position-relative form-floating">
                        <input asp-for="Input.Email" class="form-control ps-5" autocomplete="username" placeholder="Email" />
                        <label asp-for="Input.Email"><i class="bi bi-envelope form-icon"></i> Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="mb-4 position-relative form-floating">
                        <input asp-for="Input.Password" class="form-control ps-5" autocomplete="new-password" placeholder="Password" />
                        <label asp-for="Input.Password"><i class="bi bi-lock form-icon"></i> Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="mb-4 position-relative form-floating">
                        <input asp-for="Input.ConfirmPassword" class="form-control ps-5" autocomplete="new-password" placeholder="Confirm Password" />
                        <label asp-for="Input.ConfirmPassword"><i class="bi bi-check2-square form-icon"></i> Confirm Password</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow">Create Account</button>
                </form>
            </div>
            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="card-footer bg-light text-center border-0 pt-4 pb-3">
                    <p class="mb-2 text-secondary">Or register using:</p>
                    <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-flex justify-content-center gap-2">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name">
                                <i class="bi bi-box-arrow-in-right me-1"></i> @provider.DisplayName
                            </button>
                        }
                    </form>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
