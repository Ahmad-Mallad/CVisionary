@using Microsoft.AspNetCore.Identity
@inject SignInManager<Person> SignInManager
@inject UserManager<Person> UserManager
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Homepage | CVisionary</title>

    <link rel="shortcut icon" type="image/x-icon" href="~/assets/images/favicon/favicon.ico" />

    <!-- Bootstrap 5 CSS (if theme.min.css doesn’t already include it) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Theme & Custom Fonts -->
    <link rel="stylesheet" href="~/assets/css/theme.min.css" />
    <link href="~/assets/fonts/feather/feather.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Simplebar -->
    <link href="~/assets/libs/simplebar/dist/simplebar.min.css" rel="stylesheet" />

    <!-- Bootstrap Select (CSS) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css" rel="stylesheet" />

    <!-- DataTables -->
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" rel="stylesheet" />

    <link rel="canonical" href="https://geeksui.codescandy.com/geeks/index.html" />
</head>

<body class="bg-white d-flex flex-column min-vh-100">
    <!-- Page Content -->
    <nav class="navbar navbar-expand-lg">
        <div class="container px-0">
            <!-- Logo -->
            <a class="navbar-brand d-flex align-items-center gap-2" asp-action="Index" asp-controller="Home">
                <span class="cvisionary-logo fw-bold " style="font-size:25px">
                    <span class="text-primary bold">CV</span><span class="text-dark">isionary</span>
                </span>
            </a>


            <!-- Right section (Login, Language, Theme) -->
            <div class="ms-auto d-flex align-items-center order-lg-3 gap-3">


                <!-- Theme Switcher -->
                <div class="dropdown">
                    <button id="themeDropdown"
                            class="btn btn-outline-secondary btn-sm d-flex align-items-center"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="Toggle theme (auto)">
                        <i class="bi bi-circle-half"></i>
                        <span class="visually-hidden bs-theme-text">Toggle theme</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="themeDropdown">
                        <li>
                            <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="light">
                                <i class="bi bi-sun-fill"></i>
                                <span class="ms-2">Light</span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="dark">
                                <i class="bi bi-moon-stars-fill"></i>
                                <span class="ms-2">Dark</span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item d-flex align-items-center active" data-bs-theme-value="auto">
                                <i class="bi bi-circle-half"></i>
                                <span class="ms-2">Auto</span>
                            </button>
                        </li>
                    </ul>
                </div>

                <!-- Auth Buttons -->
                <ul class="navbar-nav">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @User.Identity?.Name!</a>
                        </li>
                        <li class="nav-item">
                            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
                            </form>
                        </li>
                    }


                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
                        </li>
                    }
                </ul>
            </div>

            <!-- Toggler -->
            <div>
                <button class="navbar-toggler collapsed ms-2"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbar-default"
                        aria-controls="navbar-default"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="icon-bar top-bar mt-0"></span>
                    <span class="icon-bar middle-bar"></span>
                    <span class="icon-bar bottom-bar"></span>
                </button>
            </div>

            <!-- Navigation Links -->
            <div class="collapse navbar-collapse" id="navbar-default">
                <ul class="navbar-nav mt-3 mt-lg-0 mx-xxl-auto gap-lg-3 gap-2">
                    <li class="nav-item">
                        <a class="nav-link" asp-action="Home" asp-controller="Resume">Resumes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-action="Home" asp-controller="Portfolio">Portfolios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")#contact">Contact</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("AboutUs", "Home")#aboutus">About Us</a>
                    </li>
                    <li class="nav-item">

                        @if (User.IsInRole("Admin"))
                        {
                        <li class="nav-item">
                            <a class="nav-link text-primary fw-bold" asp-area="" asp-controller="Admin" asp-action="Dashboard">
                                Admin Dashboard
                            </a>
                        </li>
                        }
                    </li>
                </ul>
            </div>
        </div>
    </nav>




    <main class="flex-fill">
        @RenderBody()
    </main>


    <!-- Footer -->
    <!-- Footer -->
    <footer class="footer bg-dark-stable py-3 text-light text-center">
        <div class="container text-white-stable text-center">
            <div class="row g-3 align-items-start">
                <div class="col-xl-4 col-lg-12 col-md-6">
                    <div class="footer-logo">
                        <span class="cvisionary-logo fw-bold">
                            <span class="cv-part">CV</span><span class="visionary-part">isionary</span>
                        </span>
                        <p class="small mt-2 mb-0">Build professional resumes and stunning portfolios powered by AI.</p>
                    </div>
                </div>

                <div class="col-xl-2 col-md-3 col-6">
                    <div>
                        <span class="fw-semibold">Explore</span>
                        <ul class="list-unstyled small mt-2 mb-0">
                            <li><a href="/Resume/Create" class="nav-link p-0">Create Resume</a></li>
                            <li><a href="/Portfolio/Create" class="nav-link p-0">Create Portfolio</a></li>
                            <li><a href="/Pricing" class="nav-link p-0">Pricing</a></li>
                            <li><a href="/FAQ" class="nav-link p-0">FAQ</a></li>
                        </ul>
                    </div>
                </div>

                <div class="col-xl-2 col-md-3 col-6">
                    <div>
                        <span class="fw-semibold">Company</span>
                        <ul class="list-unstyled small mt-2 mb-0">
                            <li><a href="/About" class="nav-link p-0">About Us</a></li>
                            <li><a href="/Contact" class="nav-link p-0">Contact</a></li>
                            <li><a href="/Blog" class="nav-link p-0">Blog</a></li>
                        </ul>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-6 col-md-6">
                    <div>
                        <span class="fw-semibold">Contact</span>
                        <ul class="list-unstyled small mt-2 mb-2">
                            <li>Email: <strong>support@airesumebuilder.com</strong></li>
                            <li>Phone: <strong>+962 79 123 4567</strong></li>
                            <li>Hours: <strong>Mon - Fri, 9am - 6pm</strong></li>
                        </ul>
                        <div>
                            <a href="#" class="me-2 text-white-stable"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="me-2 text-white-stable"><i class="bi bi-linkedin"></i></a>
                            <a href="#" class="text-white-stable"><i class="bi bi-github"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <style>
        .footer-logo .cvisionary-logo {
            font-size: 2.6rem; /* Make it large */
            letter-spacing: 0.05em;
            font-family: 'Segoe UI', 'Arial', sans-serif;
            display: inline-block;
            margin-bottom: 0.2rem
        }

        .footer-logo .cv-part {
            color: #754ffe; /* Your primary color */
            font-weight: bold;
            transition: color 0.3s;
        }

        .footer-logo .visionary-part {
            color: #fff;
            font-weight: bold;
            transition: color 0.3s;
        }

        /* Dark mode - invert colors */
        [data-bs-theme="dark"] .footer-logo .cv-part,
        body.bg-dark .footer-logo .cv-part {
            color: #fff !important;
        }

        [data-bs-theme="dark"] .footer-logo .visionary-part,
        body.bg-dark .footer-logo .visionary-part {
            color: #754ffe !important;
        }

    </style>


    <!-- Scroll top -->
    <div class="btn-scroll-top">
        <svg class="progress-square svg-content" width="100%" height="100%" viewBox="0 0 40 40">
            <path d="M8 1H32C35.866 1 39 4.13401 39 8V32C39 35.866 35.866 39 32 39H8C4.13401 39 1 35.866 1 32V8C1 4.13401 4.13401 1 8 1Z" />
        </svg>
    </div>

    <!-- Core Libraries -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Bootstrap Select -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/js/bootstrap-select.min.js"></script>

    <!-- Additional Libraries -->
    <script src="~/assets/libs/simplebar/dist/simplebar.min.js"></script>
    <script src="~/assets/libs/tiny-slider/dist/min/tiny-slider.js"></script>
    <script src="~/assets/js/vendors/tnsSlider.js"></script>

    <!-- Theme & Dark Mode -->
    <script src="~/assets/js/theme.min.js"></script>
    <script src="~/assets/js/vendors/darkMode.js"></script>

    <!-- DataTables -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>



