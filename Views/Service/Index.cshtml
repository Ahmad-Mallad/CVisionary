@model List<CVisionary.Models.Service>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Services";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Services</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add New Service
        </a>
    </div>
    <table id="allSrvicesTable" class="table table-bordered table-hover align-middle ">
        <thead class="table-light">
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Description</th>
                <th style="width:150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var service in Model)
            {
                <tr>
                    <td>
                        @if (service.ServiceImage != null)
                        {
                            <img src="@Url.Action("ServiceImage", "Service", new { id = service.ServiceId })"
                                 alt="Service Image"
                                 style="height:60px;width:60px;object-fit:cover;border-radius:8px;" />
                        }
                        else
                        {
                            <span class="text-muted small">No image</span>
                        }
                    </td>
                    <td>@service.ServiceName</td>
                    <td>@service.ServiceDescription</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@service.ServiceId" class="btn btn-sm btn-outline-primary me-1">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@service.ServiceId" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#allSrvicesTable').DataTable({
                responsive: true,
                language: {
                    searchPlaceholder: "Search services...",
                    search: "",
                }
            });
        });
    </script>
}