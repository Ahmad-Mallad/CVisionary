@{
    ViewData["Title"] = "About Us – CVisionary";
}

<section class="about-us-section py-5 bg-light">
    <div class="container">

        <div class="row justify-content-center mb-5">
            <div class="col-lg-10 text-center">
                <h1 class="fw-bold mb-3 text-primary">About Us</h1>
                <p class="lead text-muted">
                    At CVisionary, we believe in making career success accessible for everyone. Our platform harnesses the power of artificial intelligence to help graduates, students, and freelancers build standout resumes and online portfolios with confidence and ease.
                </p>
            </div>
        </div>

        <div class="row justify-content-center mb-4">
            <div class="col-lg-7 mb-4">
                <div class="card shadow border-0 p-4 h-100" style="border-radius: 1.5rem;">
                    <h3 class="text-primary mb-3">Our Mission</h3>
                    <p>
                        We are committed to empowering users to present their achievements, skills, and experiences in the best possible way. By removing barriers like design skills or writer’s block, CVisionary opens doors to more opportunities in today’s job market.
                    </p>
                </div>
            </div>
        </div>
        <div class="row justify-content-center mb-5">
            <div class="col-lg-7 mb-4">
                <div class="card shadow border-0 p-4 h-100" style="border-radius: 1.5rem;">
                    <h3 class="text-primary mb-3">Technology You Can Trust</h3>
                    <p>
                        CVisionary is built with modern, secure web technologies—ASP.NET Core MVC, Bootstrap, and cloud infrastructure—alongside OpenAI-powered language generation. This blend delivers a responsive, reliable, and intuitive platform for users everywhere.
                    </p>
                </div>
            </div>
        </div>

        <div class="row justify-content-center mb-4">
            <div class="col-lg-10 text-center">
                <h3 class="text-primary mb-4">What Makes Us Different?</h3>
            </div>
        </div>
        <div class="row g-4 justify-content-center mb-5">
            <div class="col-md-6 col-lg-3">
                <div class="card shadow-sm border-0 h-100 text-center p-4" style="border-radius:1.2rem;">
                    <i class="bi bi-lightning-charge-fill fs-2 text-primary mb-3"></i>
                    <h5 class="fw-bold mb-2">Instant, AI-powered creation</h5>
                    <p class="mb-0">Generate resumes and portfolios in seconds with advanced AI technology.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card shadow-sm border-0 h-100 text-center p-4" style="border-radius:1.2rem;">
                    <i class="bi bi-phone-fill fs-2 text-primary mb-3"></i>
                    <h5 class="fw-bold mb-2">Mobile-friendly design</h5>
                    <p class="mb-0">Enjoy a seamless experience on any device, whether desktop, tablet, or mobile.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card shadow-sm border-0 h-100 text-center p-4" style="border-radius:1.2rem;">
                    <i class="bi bi-shield-lock-fill fs-2 text-primary mb-3"></i>
                    <h5 class="fw-bold mb-2">Secure data management</h5>
                    <p class="mb-0">Your privacy and security are protected with encrypted, cloud-based storage.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card shadow-sm border-0 h-100 text-center p-4" style="border-radius:1.2rem;">
                    <i class="bi bi-bar-chart-fill fs-2 text-primary mb-3"></i>
                    <h5 class="fw-bold mb-2">Continuous improvement</h5>
                    <p class="mb-0">We constantly update CVisionary based on user feedback and the latest technology.</p>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col text-center">
                <h4 class="text-primary mb-3">Contact Us</h4>
                <p>
                    Have a question or suggestion? Email us at <a href="mailto:support@cvisionary.com">support@cvisionary.com</a>
                </p>
            </div>
        </div>
    </div>
</section>
