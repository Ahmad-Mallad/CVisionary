@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class=" py-7 py-lg-10 min-vh-100 d-flex align-items-center">
    <div class="container">
        <div class="row align-items-center">
            <!-- Text Content -->
            <div class="col-lg-6 text-center text-lg-start mb-5 mb-lg-0">
                <h1 class="display-3 fw-bold text-primary ">Create AI-Enhanced Resumes & Portfolios</h1>
                <p class="lead">Generate stunning, professional resumes and personal portfolios in seconds. Just describe your experience — we do the rest.</p>
                <ul class="list-unstyled mt-4">
                    <li><i class="bi bi-check-circle-fill text-success me-2"></i> No templates to fight with</li>
                    <li><i class="bi bi-check-circle-fill text-success me-2"></i> Smart content generation</li>
                    <li><i class="bi bi-check-circle-fill text-success me-2"></i> One-click export and share</li>
                </ul>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg mt-4">Get Started Free</a>
            </div>

            <!-- Image -->
            <div class="col-lg-6 text-center">
                <img src="~/assets/images/svg/Resume.svg" class="img-fluid ms-lg-5" alt="AI Resume Generator">
            </div>
        </div>
    </div>
</section>


<!-- Core Features -->
<section class="py-6">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col">
                <h2 class="fw-bold">What You Can Do</h2>
                <p class="text-muted">Everything you need to showcase your skills and land your dream job.</p>
            </div>
        </div>
        <div class="row g-4">
            <!-- Resume Builder Card -->
            <div class="col-md-6 d-flex">
                <div class="card card-hover-svg w-100 d-flex flex-column h-100 text-center border border-3">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="mb-3 fs-1 text-primary">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                        <h5 class="fw-semibold">AI Resume Builder</h5>
                        <p class="text-muted flex-grow-1">Simply describe your experience — our AI turns it into a clean, job-ready resume.</p>
                        <a asp-action="Home" asp-controller="Resume" class="btn btn-outline-primary mt-2">Build Resume</a>
                    </div>
                </div>
            </div>

            <!-- Portfolio Generator Card -->
            <div class="col-md-6 d-flex">
                <div class="card card-hover-svg w-100 d-flex flex-column h-100 text-center border border-3">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="mb-3 fs-1 text-info">
                            <i class="bi bi-person-lines-fill"></i>
                        </div>
                        <h5 class="fw-semibold">AI Portfolio Generator</h5>
                        <p class="text-muted flex-grow-1">Highlight your work and achievements with beautiful portfolios generated instantly.</p>
                        <a  asp-action="Home" asp-controller="Portfolio" class="btn btn-outline-info mt-2">Generate Portfolio</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



