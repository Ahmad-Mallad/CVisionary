@model List<CVisionary.Models.Resume>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "All Resumes";
}
<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">All Resumes</h5>
    </div>
    <div class="card-body">
        <table id="allResumesTable" class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Title</th>
                    <th>Created at </th>
          
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.FirstName @r.LastName</td>
                        <td>@r.Title</td>
                        <td>@r.CreatedDate</td>
                    
                        <td>
                            <a asp-controller="Resume" asp-action="Details" asp-route-id="@r.ResumeId" target="_blank" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i> View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#allResumesTable').DataTable({
                responsive: true,
                language: {
                    searchPlaceholder: "Search resumes...",
                    search: "",
                }
            });
        });
    </script>
}