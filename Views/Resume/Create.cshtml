@model CVisionary.DTOs.ResumeCreateDTO

@{
    ViewData["Title"] = "Create Resume";
}

<div class="container-fluid d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="col-lg-10 col-xl-8">
        <div class="card shadow-lg rounded-4 border border-secondary-subtle">
            <div class="card-header bg-primary text-white rounded-top-4 d-flex align-items-center gap-3 py-3 px-4">
                <i class="bi bi-file-earmark-person-fill fs-3"></i>
                <h4 class="mb-0">Create Your Resume</h4>
            </div>

            @if (ViewBag.AIErrors != null)
            {
                <div class="alert alert-danger">
                    <ul>
                        @foreach (var err in (List<string>)ViewBag.AIErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }

            <div class="card-body px-5 py-4">
                <form id="resumeForm" asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                    <!-- Personal Summary Info -->
                    <div class="row align-items-center mb-4">
                        <label asp-for="PersonalSummary" class="col-sm-3 col-form-label text-primary fw-semibold d-flex align-items-center gap-2 fs-5">
                            <i class="bi bi-person-lines-fill fs-3"></i> Personal Info & Summary
                        </label>
                        <div class="col-sm-9">
                            <textarea asp-for="PersonalSummary" class="form-control fs-5 fst-italic" rows="4" placeholder="Name, email, phone, and a short summary about yourself..."></textarea>
                            <span asp-validation-for="PersonalSummary" class="text-danger"></span>
                        </div>
                    </div>
                    <hr>

                    <!-- Professional History -->
                    <div class="row align-items-center mb-4">
                        <label asp-for="ProfessionalHistory" class="col-sm-3 col-form-label text-primary fw-semibold d-flex align-items-center gap-2 fs-5">
                            <i class="bi bi-card-text fs-3"></i> Education, Experience & Certificates
                        </label>
                        <div class="col-sm-9">
                            <textarea asp-for="ProfessionalHistory" class="form-control fs-5 fst-italic" rows="3" placeholder="List your education, work history, certificates, etc..."></textarea>
                            <span asp-validation-for="ProfessionalHistory" class="text-danger"></span>
                        </div>
                    </div>
                    <hr>

                    <!-- Professional Skills -->
                    <div class="row align-items-center mb-4">
                        <label asp-for="ProfessionalSkills" class="col-sm-3 col-form-label text-primary fw-semibold d-flex align-items-center gap-2 fs-5">
                            <i class="bi bi-mortarboard fs-3"></i> Skills & Languages
                        </label>
                        <div class="col-sm-9">
                            <textarea asp-for="ProfessionalSkills" class="form-control fs-5 fst-italic" rows="3" placeholder="List your main skills and languages..."></textarea>
                            <span asp-validation-for="ProfessionalSkills" class="text-danger"></span>
                        </div>
                    </div>
                    <hr>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold text-white py-3 rounded-4 shadow-sm">
                            Generate Resume
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Resume Generating Modal -->
<div class="modal fade" id="resumeGeneratingModal" tabindex="-1" aria-labelledby="resumeGeneratingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white text-center">
            <div class="modal-body py-5">
                <div class="mb-3">
                    <div class="spinner-border text-primary" style="width: 4rem; height: 4rem;" role="status"></div>
                </div>
                <h4 id="resumeGeneratingModalLabel">Creating your AI-powered resume...</h4>
                <div class="mt-3 fs-5" id="motivationalPhrase">Analyzing your experience and skills...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        const phrases = [
            "Almost there! Your future is loading...",
            "Analyzing your experience and skills...",
            "Building your resume with AI magic..."
        ];

        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("resumeForm");
            const modal = new bootstrap.Modal(document.getElementById('resumeGeneratingModal'), {
                backdrop: 'static',
                keyboard: false
            });
            const phraseEl = document.getElementById("motivationalPhrase");

            if (form) {
                form.addEventListener("submit", async function (e) {
                    e.preventDefault(); // ✅ Prevent normal form submission

                    // ✅ Validate
                    let isValid = true;
                    if (typeof $ !== 'undefined' && $(form).valid) {
                        isValid = $(form).valid();
                    } else if (form.checkValidity) {
                        isValid = form.checkValidity();
                    }

                    if (!isValid) {
                        return;
                    }

                    // ✅ Show modal
                    let phraseIdx = 0;
                    phraseEl.innerText = phrases[phraseIdx];

                    const interval = setInterval(() => {
                        phraseIdx = (phraseIdx + 1) % phrases.length;
                        phraseEl.innerText = phrases[phraseIdx];
                    }, 2000);

                    modal.show();

                    try {
                        const formData = new FormData(form);

                        const response = await fetch(form.action, {
                            method: "POST",
                            body: formData
                        });

                        const resultHtml = await response.text();

                        const newTab = window.open("", "_blank");
                        if (newTab) {
                            newTab.document.open();
                            newTab.document.write(resultHtml);
                            newTab.document.close();
                        } else {
                            alert("Popup blocked! Please allow popups for this site.");
                        }

                    } catch (error) {
                        alert("An error occurred while creating your resume.");
                        console.error(error);
                    } finally {
                        clearInterval(interval);
                        modal.hide();
                    }
                });
            }
        });
    </script>
}

