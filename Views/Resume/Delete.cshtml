@model Resume

@{
    ViewData["Title"] = "Delete Resume";
}

<div class="container mt-5">
    <div class="card shadow border-danger">
        <div class="card-body">
            <h3 class="text-danger">Are you sure you want to delete this resume?</h3>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">First Name</dt>
                <dd class="col-sm-9">@Model.FirstName</dd>

                <dt class="col-sm-3">Last Name</dt>
                <dd class="col-sm-9">@Model.LastName</dd>

                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Title</dd>
            </dl>

            <form asp-controller="Resume" asp-action="DeleteConfirmed" method="post">
                <input type="hidden" asp-for="ResumeId"  />

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
