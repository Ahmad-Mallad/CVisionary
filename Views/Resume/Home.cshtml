@{
    ViewData["Title"] = "Resume Home";
}

<!-- Resume Builder Main Section -->
<section class="py-7 bg-light min-vh-100 d-flex align-items-center">
    <div class="container">
        <div class="row align-items-center justify-content-between">
            <!-- Text Content -->
            <div class="col-lg-6 mb-5 mb-lg-0">
                <h1 class="fw-bold display-4 text-primary ">Welcome to Your AI Resume Hub</h1>
                <p class="lead text-muted">Generate professional resumes in seconds using AI, and manage all your resume versions in one place.</p>

                <div class="d-flex flex-column flex-md-row gap-3 mt-4">
                    <a asp-action="Create" class="btn btn-primary btn-lg px-4 shadow-sm">
                        <i class="bi bi-plus-circle me-2"></i> Create New Resume
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="bi bi-folder2-open me-2"></i> Manage My Resumes
                    </a>
                </div>
            </div>

            <!-- Illustration -->
            <div class="col-lg-6 text-center  ">
                <img src="~/assets/images/svg/undraw_organize-resume_ihw6.svg"
                     alt="Organize Resume Illustration"
                     style="width: 100%; max-width: 600px; height: auto; max-height: 600px;" />
            </div>
            </div>
        </div>
   
</section>

<!-- Custom Styles -->

<style>
    .transition-hover {
        transition: all 0.3s ease-in-out;
    }

        .transition-hover:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 28px rgba(0, 0, 0, 0.1);
        }

    .resume-box {
        max-width: 400px;
        margin: 0 auto;
    }

</style>

