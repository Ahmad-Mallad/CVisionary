@{
    ViewData["Title"] = "My Resumes";
    var resumes = (List<Resume>)ViewBag.Resumes;
}

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-body">
            <h2 class="mb-4 fw-bold text-center">My Resumes</h2>

            <table id="resumesTable" class="table table-bordered border-primary table-striped table-hover" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Title</th>
                        <th style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (resumes != null && resumes.Any())
                    {
                        foreach (var item in resumes)
                        {
                            <tr>
                                <td>@item.FirstName</td>
                                <td>@item.LastName</td>
                                <td>@item.Title</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-controller="Resume" asp-route-id="@item.ResumeId" class="btn btn-sm btn-outline-primary">Edit</a>
                                        <a asp-action="Delete" asp-controller="Resume" asp-route-id="@item.ResumeId" class="btn btn-sm btn-outline-danger">Delete</a>
                                        <a asp-action="Details" asp-controller="Resume" asp-route-id="@item.ResumeId" class="btn btn-sm btn-outline-success" target="_blank">View</a>
                                        <a asp-action="DownloadPdf" asp-route-id="@item.ResumeId" class="btn btn-dark">PDF</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">No resumes found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#resumesTable').DataTable({
                responsive: true,
                language: {
                    searchPlaceholder: "Search resumes...",
                    search: "",
                }
            });
        });
    </script>
}
