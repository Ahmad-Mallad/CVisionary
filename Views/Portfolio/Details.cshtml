@model CVisionary.Models.Portfolio

@{
    Layout = "_PortfolioLayout";
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName} – Portfolio";
}

<style>
    /* Section spacing */
    .section {
        padding: 6rem 0;
    }
    /* Card hover effect */
    .service-card, .project-card {
        transition: transform .2s, box-shadow .2s;
    }

        .service-card:hover, .project-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15);
        }
    /* Smooth anchor scroll */
    html {
        scroll-behavior: smooth;
    }
</style>

<!-- About -->
<section id="about" class="section bg-light text-center">
    <div class="container">
        @if (Model.PortfolioImage != null)
        {
            <img src="@Url.Action("Image","Portfolio", new { entity = "portfolio", id = Model.PortfolioId })"
                 alt="Profile photo of @Model.FirstName"
                 class="rounded-circle mb-4"
                 style="width:200px;height:200px;object-fit:cover;" />
        }
        else
        {
            <i class="bi bi-person-circle mb-4" style="font-size:200px;color:#ccc;"></i>
        }

        <h1 class="fw-bold">@Model.FirstName @Model.LastName</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Title))
        {
            <p class="lead text-muted">@Model.Title</p>
        }
        <div class="mx-auto" style="max-width:600px">
            <p>@Model.Summary</p>
        </div>
    </div>
</section>

<section id="services" class="section">
    <div class="container">
        <h2 class="text-center mb-5">Services</h2>
        <div class="row g-4">
            @foreach (var ps in Model.PortfolioServices)
            {
                <div class="col-md-4">
                    <div class="card service-card h-100 border-1">
                        @if (ps.Service.ServiceImage != null)
                        {
                            <img src="@Url.Action("Image", "Portfolio", new { entity = "service", id = ps.Service.ServiceId })"
                                 alt="@ps.Service.ServiceName"
                                 class="card-img-top"
                                 style="width:100%;height:225px;object-fit:contain; background:#f8f9fa;" />
                        }
                        else
                        {
                            <div class="d-flex justify-content-center align-items-center" style="height:250px; background:#f5f5f5;">
                                <i class="bi bi-briefcase-fill fs-1 text-primary"></i>
                            </div>
                        }
                        <div class="card-body text-center">
                            <h5 class="card-title">@ps.Service.ServiceName</h5>
                            <p class="card-text text-muted">@ps.Service.ServiceDescription</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Projects -->
<section id="projects" class="section bg-light">
    <div class="container">
        <h2 class="text-center mb-5">Projects</h2>
        <div class="row g-4">
            @foreach (var p in Model.Projects)
            {
                <div class="col-md-6">
                    <div class="card project-card h-100 border-0">
                        @if (p.ProjectFile != null)
                        {
                            <img src="@Url.Action("Image","Portfolio", new { entity = "project", id = p.ProjectId })"
                                 class="card-img-top"
                                 style="height:250px;object-fit:contain;"
                                 alt="@p.ProjectName" />
                        }
                        <div class="card-body">
                            <h5 class="card-title">@p.ProjectName</h5>
                            @if (!string.IsNullOrEmpty(p.ProjectLink))
                            {
                                <p><a href="@p.ProjectLink" target="_blank">@p.ProjectLink</a></p>
                            }
                            <p class="card-text">@p.ProjectDescription</p>
                        </div>
                        <div class="card-footer text-muted small">
                            @(p.StartDate?.ToString("yyyy-MM-dd") ?? "")
                            &ndash;
                            @(p.EndDate.HasValue
                                ? p.EndDate.Value.ToString("yyyy-MM-dd")
                                : "Present")
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Contact -->
<section id="contact" class="section">
    <div class="container text-center">
        <h2 class="mb-4">Contact</h2>
        <ul class="list-unstyled fs-5">
            @if (!string.IsNullOrEmpty(Model.Email))
            {
                <li>
                    <i class="bi bi-envelope-fill me-2"></i>
                    <a href="mailto:@Model.Email">@Model.Email</a>
                </li>
            }
            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
            {
                <li><i class="bi bi-telephone-fill me-2"></i>@Model.PhoneNumber</li>
            }
            @if (!string.IsNullOrEmpty(Model.LinkedInLink))
            {
                <li>
                    <i class="bi bi-linkedin me-2"></i>
                    <a href="@Model.LinkedInLink" target="_blank">LinkedIn</a>
                </li>
            }
            @if (!string.IsNullOrEmpty(Model.GithubLink))
            {
                <li>
                    <i class="bi bi-github me-2"></i>
                    <a href="@Model.GithubLink" target="_blank">GitHub</a>
                </li>
            }
        </ul>
    </div>
</section>
