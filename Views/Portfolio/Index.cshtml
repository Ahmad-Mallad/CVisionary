@using CVisionary.Models
@{
    ViewData["Title"] = "My Portfolios";
    var portfolios = (List<Portfolio>)ViewBag.Portfolios;
}

<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />


<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-body">
            <h2 class="mb-4 fw-bold text-center">My Portfolios</h2>

            <table id="portfoliosTable" class="table table-bordered border-primary table-striped table-hover" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Title</th>
                        <th style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (portfolios != null && portfolios.Any())
                    {
                        foreach (var item in portfolios)
                        {
                            <tr>
                                <td>@item.FirstName</td>
                                <td>@item.LastName</td>
                                <td>@item.Title</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-controller="Portfolio" asp-route-id="@item.PortfolioId"
                                           class="btn btn-sm btn-outline-primary">Edit</a>
                                        <a asp-action="Delete" asp-controller="Portfolio" asp-route-id="@item.PortfolioId"
                                           class="btn btn-sm btn-outline-danger">Delete</a>
                                        <a asp-action="Details" asp-controller="Portfolio" asp-route-id="@item.PortfolioId"
                                           class="btn btn-sm btn-outline-success" target="_blank">template 1</a>
                                        <a asp-action="Details2" asp-controller="Portfolio" asp-route-id="@item.PortfolioId"
                                           class="btn btn-sm btn-outline-warning" target="_blank">template 2</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">No portfolios found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg">
            <div class="modal-body text-center py-5">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
                <h4 class="mt-3 mb-2" id="successModalLabel">Success!</h4>
                <div class="mb-2" id="successModalMessage"></div>
                <button type="button" class="btn btn-success px-4 mt-2" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<!-- DataTables JS -->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#portfoliosTable').DataTable({
                responsive: true,
                language: {
                    searchPlaceholder: "Search portfolios...",
                    search: "",
                }
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            var msg = '@TempData["SuccessMessage"]';
            if (msg) {
                // Set the message text
                $("#successModalMessage").text(msg);
                // Show the modal
                var modal = new bootstrap.Modal(document.getElementById('successModal'));
                modal.show();
            }
        });
    </script>
}