<!-- About Section -->
<section id="about" class="about section bg-light">
    <div class="container section-title" data-aos="fade-up">
        <h2 class="mb-5">About</h2>
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card shadow border-0 p-5 mx-auto" style="border-radius:2rem; background:rgba(255,255,255,0.97);">
                    <div class="d-flex flex-column align-items-center">
                        <i class="bi bi-quote text-primary display-3 mb-3"></i>
                        <h3 class="fw-semibold text-primary mb-4" style="font-size:2.4rem;">
                            @Model.Title
                        </h3>
                        @if (!string.IsNullOrWhiteSpace(Model.Summary))
                        {
                            <p class="fst-italic mb-0" style="font-size:1.35rem; line-height:2; color:#555; max-width:800px;">
                                @Model.Summary
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- Services Section -->
<section id="services" class="services section">
    <div class="container section-title" data-aos="fade-up">
        <h2 class="mb-4">Services</h2>
    </div>
    <div class="container">
        <div class="row g-5 mb-5">
            @foreach (var ps in Model.PortfolioServices)
            {
                <div class="col-lg-4 col-md-6 d-flex align-items-stretch">
                    <div class="card service-card h-100 w-100 border-0 shadow-lg p-5" style="border-radius:2rem; min-height:380px;">
                        <div class="d-flex flex-column align-items-center mb-4">
                            @if (ps.Service.ServiceImage != null)
                            {
                                         <img src="@Url.Action("Image", "Portfolio", new { entity = "service", id = ps.Service.ServiceId })"
                                         alt="@ps.Service.ServiceName"
                                         class="card-img-top"
                                         style="width:100%;height:200px;object-fit:contain; background:#f8f9fa;" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center rounded-circle shadow-sm mb-3"
                                     style="height:150px;width:150px; background:#f0f0ff;">
                                    <i class="bi bi-briefcase fs-1 text-primary"></i>
                                </div>
                            }
                            <h4 class="fw-bold text-primary mb-2 text-center">@ps.Service.ServiceName</h4>
                        </div>
                        <p class="fs-5 text-muted mb-0 text-center" style="min-height:64px;">@ps.Service.ServiceDescription</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="projects" class="section bg-light">
    <div class="container section-title" data-aos="fade-up">
        <h2 class="mb-4">Projects</h2>
    </div>
    <div class="container">
        <div class="row g-5 mb-5">
            @foreach (var p in Model.Projects)
            {
                <div class="col-lg-4 col-md-6 d-flex align-items-stretch">
                    <div class="card project-card h-100 w-100 border-0 shadow-lg px-4 py-5" style="border-radius:2rem; min-height:420px;">
                        @if (p.ProjectFile != null)
                        {
                            <img src="@Url.Action("Image", "Portfolio", new { entity = "project", id = p.ProjectId })"
                                 class="card-img-top mb-4"
                                 style="height:190px;object-fit:contain;border-radius:1.5rem;"
                                 alt="@p.ProjectName" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center mb-4"
                                 style="height:190px; background:#f6f6f6; border-radius:1.5rem;">
                                <i class="bi bi-folder2-open fs-1 text-primary"></i>
                            </div>
                        }

                        <h5 class="card-title mb-3 text-primary text-center mt-3">@p.ProjectName</h5>

                        @if (!string.IsNullOrEmpty(p.ProjectLink))
                        {
                            <p class="text-center mb-3">
                                <a href="@p.ProjectLink" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-link-45deg"></i> Visit Project
                                </a>
                            </p>
                        }

                        <p class="card-text text-muted mb-4 text-center" style="min-height:40px;">@p.ProjectDescription</p>

                        <div class="text-muted small text-center mt-auto pt-2">
                            <i class="bi bi-calendar-week me-1"></i>
                            @(p.StartDate?.ToString("yyyy-MM-dd") ?? "")
                            &ndash;
                            @(p.EndDate.HasValue
                                ? p.EndDate.Value.ToString("yyyy-MM-dd")
                                : "Present")
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
