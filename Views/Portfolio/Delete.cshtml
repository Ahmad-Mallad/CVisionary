@model CVisionary.Models.Portfolio

@{
    ViewData["Title"] = "Delete Portfolio";
}

<div class="container mt-5">
    <div class="card border-danger shadow">
        <div class="card-body text-center">
            <h2 class="mb-4 text-danger fw-bold">Delete Portfolio</h2>
            <p>Are you sure you want to delete the portfolio for <strong>@Model.FirstName @Model.LastName</strong>?</p>

            <form asp-action="DeleteConfirmed" asp-controller="Portfolio" method="post">
                <input type="hidden" asp-for="PortfolioId"  />
                <button type="submit" class="btn btn-danger me-2">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
